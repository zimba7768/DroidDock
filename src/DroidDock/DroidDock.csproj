<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DroidDock</AssemblyName>
    <RootNamespace>DroidDock</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Pack WPF's native DLLs inside the single-file exe so it runs on its own. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Description>Run Android apps on Windows with a one-click wrapper around the official Android Emulator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DroidDock.Tests" />
  </ItemGroup>

</Project>
