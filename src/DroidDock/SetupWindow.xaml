<Window x:Class="DroidDock.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android components" Width="620" Height="640" MinWidth="520" MinHeight="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Download Android components" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0">
                DroidDock downloads these straight from Google (dl.google.com) and verifies each file's checksum.
                Nothing is bundled with DroidDock itself.
            </TextBlock>
            <TextBlock x:Name="LocationText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="ComponentsPanel" IsEnabled="False">
            <CheckBox x:Name="EmulatorCheck" Content="Android Emulator" Margin="0,0,0,8"/>
            <CheckBox x:Name="PlatformToolsCheck" Content="Platform tools (adb)" Margin="0,0,0,12"/>
            <TextBlock Text="Android system image" Margin="0,0,0,4"/>
            <ComboBox x:Name="ImageCombo" Padding="6,5" Margin="0,0,0,4"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="“Google Play” images include the Play Store. “Google APIs” images have no Play Store but allow root access."/>
        </StackPanel>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="License agreement" Margin="0,0,0,4"/>
            <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="12" Background="{StaticResource Panel}" Foreground="{StaticResource Muted}"
                     Text="Loading the package list from Google…"/>
        </DockPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="AcceptCheck" Content="I have read and accept the license agreement above" IsEnabled="False"
                      Click="Accept_Click"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,4" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource Accent}"
                         Background="{StaticResource Panel}" BorderThickness="0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Content="Close" Click="Close_Click"/>
            <Button x:Name="InstallButton" Content="Download and install" Style="{StaticResource AccentButton}"
                    IsEnabled="False" Click="Install_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
