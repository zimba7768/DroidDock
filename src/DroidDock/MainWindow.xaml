<Window x:Class="DroidDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DroidDock" Width="1040" Height="700" MinWidth="820" MinHeight="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold">
                    <Run Text="Droid" Foreground="{StaticResource Accent}"/><Run Text="Dock"/>
                </TextBlock>
                <TextBlock x:Name="SdkText" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SetupButton" Content="Android components…" Click="Setup_Click"
                    VerticalAlignment="Center" Margin="0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Devices -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VIRTUAL DEVICES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" Margin="4,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="StartButton" Content="▶  Start" Style="{StaticResource AccentButton}" Click="Start_Click"/>
                            <Button x:Name="StopButton" Content="■  Stop" Click="Stop_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋  New device" Click="NewDevice_Click"/>
                            <Button x:Name="DeleteButton" Content="Delete" Foreground="{StaticResource Danger}" Click="Delete_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="DeviceList" SelectionChanged="DeviceList_SelectionChanged"
                                 MouseDoubleClick="DeviceList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"
                                                 VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoDevicesText" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="16"
                                   Text="No virtual devices yet.&#10;Click “New device” to create one."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Apps -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AppsTitle" Text="APPS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="SystemAppsCheck" Content="Show system apps" Margin="0,0,12,0"
                                      Checked="SystemApps_Click" Unchecked="SystemApps_Click"/>
                            <Button Content="Refresh" Click="RefreshApps_Click" Padding="10,4"/>
                            <Button x:Name="InstallButton" Content="Install APK…" Style="{StaticResource AccentButton}"
                                    Click="InstallApk_Click" Padding="10,4" Margin="0"/>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <TextBlock Text="Drag and drop .apk files anywhere on this window to install them on the running device."
                                   Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <Grid>
                        <ListBox x:Name="AppList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Package}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Open" Click="LaunchApp_Click" Padding="10,3"/>
                                            <Button Content="Uninstall" Click="UninstallApp_Click" Padding="10,3" Margin="0"
                                                    Foreground="{StaticResource Danger}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="AppsHint" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" Margin="24"
                                   Text="Start a device to see and install its apps."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Log -->
        <TextBox Grid.Row="2" x:Name="LogBox" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource Panel}" BorderThickness="0" Foreground="{StaticResource Muted}"/>

        <!-- Status -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" Text="Ready"/>
            <ProgressBar Grid.Column="1" x:Name="Busy" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{StaticResource Accent}" Background="{StaticResource Panel}" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
